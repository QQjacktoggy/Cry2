# Binance Mainnet
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Binance Testnet
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# GCP (production only)
# GOOGLE_CLOUD_PROJECT=binance-bot-prod
#
# Default Secret Manager ID mapping when GOOGLE_CLOUD_PROJECT is set:
#   BINANCE_API_KEY            -> binance-api-key
#   BINANCE_API_SECRET         -> binance-api-secret
#   BINANCE_TESTNET_API_KEY    -> binance-testnet-api-key
#   BINANCE_TESTNET_API_SECRET -> binance-testnet-api-secret
#   TELEGRAM_BOT_TOKEN         -> telegram-bot-token
#   TELEGRAM_CHAT_ID           -> telegram-chat-id
#
# Optional per-secret overrides:
# SECRET_NAME_FOR_BINANCE_TESTNET_API_KEY=custom-testnet-api-key
# SECRET_NAME_FOR_BINANCE_TESTNET_API_SECRET=custom-testnet-api-secret
